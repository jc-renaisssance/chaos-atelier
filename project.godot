; Engine configuration file.
; Chaos Atelier — Client 1B stamina craft + schedule board.
; Live spine: docs/27-craft-mode-stamina.md, docs/22-chapter-schedule.md, docs/20-harness-stamp.md.
; Target editor: Godot 4.7 (Jonathan). Scripts are normal Godot 4 GDScript.

config_version=5

[application]

config/name="Chaos Atelier"
config/description="Travelling atelier — stamina craft (Client 1B)"
run/main_scene="res://src/ui/schedule/schedule_board.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameConstants="*res://src/autoload/game_constants.gd"
AtelierSession="*res://src/autoload/atelier_session.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
