; Engine configuration file.
; Chaos Atelier — Client 1B own_basic loop (schedule + stamina + mission).
; Live spine: docs/22, docs/27, docs/20, docs/23, docs/24.
; Target editor: Godot 4.7 (Jonathan). Scripts are normal Godot 4 GDScript.

config_version=5

[application]

config/name="Chaos Atelier"
config/description="Travelling atelier — own_basic chapter loop (Client 1B)"
run/main_scene="res://src/ui/schedule/schedule_board.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameConstants="*res://src/autoload/game_constants.gd"
AtelierSession="*res://src/autoload/atelier_session.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
